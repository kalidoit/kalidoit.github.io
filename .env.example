# 复制本文件为 .env 并填入你的值（.env 不入库，请勿提交，已加入 .gitignore）

# ===== 账户体系（推荐：用它创建管理员，替代旧 ADMIN_TOKEN） =====
# 首次启动且 data/admin.json 为空时，会自动用下面的凭据创建初始管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成>=10位且含大小写+数字+符号的强密码
ADMIN_EMAIL=you@example.com

# 会话签名密钥：请改成强随机字符串（或用 `openssl rand -hex 32` 生成）。
# 留空时会自动生成并存入 data/.session_secret，重启仍有效。
SESSION_SECRET=

# 遗留后备令牌（开发期可用；公网部署建议留空以免绕过账户体系）
ADMIN_TOKEN=

# ===== 鉴权开关 =====
# false = 测试模式：免登录，直接以 local-admin 进入后台（方便本地调试）
# true  = 启用完整账户体系：scrypt 密码哈希 + HMAC 会话 + TOTP 二次验证
# 公网部署【必须】设为 true，并配置 ADMIN_PASSWORD。本地自测也可先设 true 走初始化向导。
AUTH_ENABLED=true

# 服务端口（默认 8080）
PORT=8080

# 公网部署：设为 1 后，仅允许 HTTPS（由反代注入 x-forwarded-proto）与本地访问 /api 与 /admin
# REQUIRE_HTTPS=1
